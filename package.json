{
  "name": "arb-token-bridge-ui-mono",
  "private": true,
  "license": "UNLICENSED",
  "version": "1.0.0",
  "type": "module",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "pnpm --filter app dev",
    "build": "pnpm --filter app build",
    "start": "pnpm --filter app start",
    "audit:ci": "audit-ci --config ./audit-ci.jsonc",
    "test:unit": "pnpm --filter arb-token-bridge-ui test:unit && pnpm --filter app test:ci",
    "test:integration": "pnpm --filter arb-token-bridge-ui test:integration",
    "test:ci": "pnpm test:unit && pnpm test:integration",
    "prettier:check": "prettier --check .",
    "prettier:format": "prettier --write .",
    "lint": "tsc && oxlint",
    "lint:fix": "tsc && oxlint --quiet --fix",
    "postinstall": "pnpm run install:chromium",
    "install:chromium": "pnpm dlx @puppeteer/browsers install chrome@$npm_package_config_chromeVersion --path $npm_package_config_chromePath",
    "test:e2e": "pnpm --filter arb-token-bridge-ui exec env-cmd --silent --file .e2e.env pnpm exec playwright test",
    "test:e2e:orbit": "E2E_ORBIT=true pnpm run test:e2e",
    "test:e2e:orbit:custom-gas-token": "E2E_ORBIT_CUSTOM_GAS_TOKEN=true pnpm run test:e2e"
  },
  "keywords": [],
  "author": "",
  "packageManager": "pnpm@11.21.0",
  "devDependencies": {
    "@headlessui/react": "^2.2.10",
    "@headlessui/tailwindcss": "^0.2.2",
    "@heroicons/react": "^2.2.0",
    "@offchainlabs/prettier-config": "^0.3.0",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/node": "^22.19.19",
    "@typescript/native": "npm:typescript@^7.0.2",
    "audit-ci": "^7.1.0",
    "eslint-plugin-zustand-rules": "^1.2.1",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2004",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "config": {
    "chromeVersion": "128.0.6613.137",
    "chromePath": "node_modules/.cache/synpress"
  }
}

{
  "$schema": "https://github.com/IBM/audit-ci/raw/main/docs/schema.json",
  "low": true,
  "allowlist": [
    // https://github.com/advisories/GHSA-vqpr-j7v3-hqw9
    // Valibot has a ReDoS vulnerability in `EMOJI_REGEX`
    // Reason to ignore: Not used directly. Patched version is a major bump (v1.2.0).
    // from: arb-token-bridge-ui>@lifi/sdk>bitcoinjs-lib>valibot
    "GHSA-vqpr-j7v3-hqw9",
    //
    // https://github.com/advisories/GHSA-5qjj-4xww-7phc
    // Valibot record() issue paths can make flatten() throw for inherited Object property names
    // Reason to ignore: Not used directly and we never call valibot's flatten(). Patched version (1.4.2) is a major bump the parents don't support (they pin ^0.36/^0.38).
    // from: arb-token-bridge-ui>@lifi/sdk>bitcoinjs-lib>valibot
    "GHSA-5qjj-4xww-7phc",
    //
    // https://github.com/advisories/GHSA-848j-6mx2-7j84
    // Elliptic Uses a Cryptographic Primitive with a Risky Implementation
    // CVE-2025-14505: ECDSA implementation generates incorrect signatures if interim value 'k' has leading zeros
    // Reason to ignore: Low severity vulnerability with no patched version available yet
    "GHSA-848j-6mx2-7j84",
    //
    // https://github.com/advisories/GHSA-x3ff-w252-2g7j
    // @stablelib/ed25519 side-channel timing vulnerability
    // Reason to ignore: No patched version available. Transitive dependency via WalletConnect.
    // from: app>wagmi>@wagmi/connectors>@walletconnect/ethereum-provider>...>@walletconnect/relay-auth>@stablelib/ed25519
    "GHSA-x3ff-w252-2g7j",
    //
    // https://github.com/advisories/GHSA-pfrx-2q88-qq97
    // got allows a redirect to a UNIX socket (CVE-2022-33987)
    //
    // https://github.com/advisories/GHSA-rc47-6667-2j5j
    // http-cache-semantics vulnerable to Regular Expression Denial of Service (CVE-2022-25881)
    //
    // https://github.com/advisories/GHSA-ch52-4w7c-c8xp
    // http-cache-semantics max-stale handling can disclose cross-user cached responses (CVE-2026-93748)
    // No backport: only 4.3.0 is patched; cacheable-request@2 in the synpress chain pins ^3.8.1
    //
    // https://github.com/advisories/GHSA-p8p7-x288-28g6
    // Server-Side Request Forgery in @cypress/request (CVE-2023-28155)
    //
    // https://github.com/advisories/GHSA-8mmm-9v2q-x3f9
    // tschaub gh-pages vulnerable to prototype pollution (CVE-2022-37611)
    //
    // https://github.com/advisories/GHSA-9jgg-88mc-972h
    // webpack-dev-server users' source code may be stolen via malicious site, non-Chromium (CVE-2025-30360)
    //
    // https://github.com/advisories/GHSA-4v9v-hfq4-rm2v
    // webpack-dev-server users' source code may be stolen via malicious site (CVE-2025-30359)
    //
    // https://github.com/advisories/GHSA-79cf-xcqc-c78w
    // webpack-dev-server cross-origin source code exposure on non-HTTPS origins (CVE-2026-6402)
    //
    // https://github.com/advisories/GHSA-f5vj-f2hx-8m93
    // webpack-dev-server cross-site request forgery via internal endpoints
    //
    // https://github.com/advisories/GHSA-m28w-2pqf-7qgj
    // webpack-dev-server denial of service via a malformed Host header
    //
    // https://github.com/advisories/GHSA-v6wh-96g9-6wx3
    // launch-editor leaks NTLMv2 hashes via unvalidated Windows UNC paths on the dev-server __open-in-editor endpoint (CVE-2026-53632)
    //
    // https://github.com/advisories/GHSA-mx8g-39q3-5c79
    // webpack-dev-server HMR WebSocket interception via permissive user proxies leaks credentials (CVE-2026-9595)
    //
    // https://github.com/advisories/GHSA-64mm-vxmg-q3vj
    // http-proxy-middleware host-header-driven backend routing bypass via substring matching in router rules (CVE-2026-55602)
    //
    // https://github.com/advisories/GHSA-g84c-rxfj-3j2c
    // webpack-dev-middleware path traversal outside the output directory via a non-slash-terminated publicPath (CVE-2026-76844)
    // No backport: only 7.4.6 and 8.3.0 are patched; webpack-dev-server 4 in the synpress chain requires 5.x
    //
    // https://github.com/advisories/GHSA-mp2f-45pm-3cg9
    // decompress archive extraction can create files and links outside the target directory (CVE-2026-53486)
    // No upstream fix: decompress is unmaintained, patched only in the @xhmikosr/decompress ESM fork
    //
    // https://github.com/advisories/GHSA-h39j-r5qq-r9mm
    // decompress arbitrary file write (Zip Slip) via a symlink race on ZIP archives with duplicate paths (CVE-2026-10732)
    // No upstream fix: decompress is unmaintained, 4.2.1 is the latest published version
    //
    // https://github.com/advisories/GHSA-jwp9-9v96-94mx
    // decompress allows arbitrary hardlink creation via unvalidated linkname during archive extraction (CVE-2026-39243)
    // No upstream fix: decompress is unmaintained, 4.2.1 is the latest published version
    //
    // https://github.com/advisories/GHSA-hrh2-vp3x-79xf
    // decompress path traversal via a chain of symlink entries resolving outside the output directory (CVE-2026-101894)
    // No upstream fix: decompress is unmaintained, patched only in the @xhmikosr/decompress ESM fork
    //
    // https://github.com/advisories/GHSA-xv26-6w52-cph6
    // websocket-driver message corruption via abuse of protocol length headers
    //
    // https://github.com/advisories/GHSA-mp7j-qc5w-4988
    // websocket-driver resource limit bypass via message compression
    //
    // Reason to ignore: All from @synthetixio/synpress, an E2E test devDependency.
    // Each fix requires a major bump deep in the synpress chain that would risk
    // breaking E2E tooling. Not used in production builds or runtime code.
    // from: arb-token-bridge-ui>@synthetixio/synpress>...
    "GHSA-pfrx-2q88-qq97",
    "GHSA-rc47-6667-2j5j",
    "GHSA-ch52-4w7c-c8xp",
    "GHSA-p8p7-x288-28g6",
    "GHSA-8mmm-9v2q-x3f9",
    "GHSA-9jgg-88mc-972h",
    "GHSA-4v9v-hfq4-rm2v",
    "GHSA-79cf-xcqc-c78w",
    "GHSA-f5vj-f2hx-8m93",
    "GHSA-m28w-2pqf-7qgj",
    "GHSA-v6wh-96g9-6wx3",
    "GHSA-mx8g-39q3-5c79",
    "GHSA-64mm-vxmg-q3vj",
    "GHSA-g84c-rxfj-3j2c",
    "GHSA-mp2f-45pm-3cg9",
    "GHSA-h39j-r5qq-r9mm",
    "GHSA-jwp9-9v96-94mx",
    "GHSA-hrh2-vp3x-79xf",
    "GHSA-xv26-6w52-cph6",
    "GHSA-mp7j-qc5w-4988",
    //
    // https://github.com/advisories/GHSA-qjx8-664m-686j
    // js-cookie prototype hijack in assign() enables cookie-attribute injection (CVE-2026-46625)
    // Reason to ignore: Only pulled in transitively via react-use's useCookie hook,
    // which we never import. The vulnerable js-cookie code path is not reached.
    // Patched version (3.0.7) is a major bump from react-use's pinned 2.x.
    // from: react-use>js-cookie
    "GHSA-qjx8-664m-686j",
    //
    // https://github.com/advisories/GHSA-jmr9-qjv8-65gv
    // extract-zip does not validate symlink targets during extraction, so a malicious
    // archive can read or write files outside the target directory (CVE-2026-56876)
    //
    // https://github.com/advisories/GHSA-7pqw-9j4j-h8q3
    // extract-zip allows arbitrary file writes through symlink archive entries
    // (CVE-2026-19693), a variant of the above
    //
    // Reason to ignore: No patched version available (2.0.1 is the latest published
    // version, last modified 2023; GitHub lists no patched version).
    // Dev-only: cypress uses it to unpack its own binary from the official
    // Cypress CDN, so we never extract untrusted archives. Not in production builds.
    // from: arb-token-bridge-ui>@synthetixio/synpress>cypress>extract-zip
    "GHSA-jmr9-qjv8-65gv",
    "GHSA-7pqw-9j4j-h8q3",
    //
    // https://github.com/advisories/GHSA-vcc3-ghjq-m6fr
    // decode-uri-component denial of service via exponential decoding of malformed
    // percent-encoded input (CVE-2026-45822)
    // Fixed for our own query-string usage: pnpm-workspace.yaml overrides
    // 'query-string@9>decode-uri-component' to 0.5.0, so the copy that parses
    // browser URL query params in the app, bridge and portal is patched.
    // Reason to ignore the paths below: the patch only ships as ESM (0.2.2 is the
    // last CJS release and it is vulnerable), while query-string@5/7 in these chains
    // `require()` it, so overriding them would break at runtime. No CJS fix exists.
    // @walletconnect/utils is reached only through @walletconnect/ethereum-provider,
    // which is pinned to 2.13.1; synpress is an E2E test devDependency.
    // from: app>wagmi>@wagmi/connectors>@walletconnect/ethereum-provider>...>@walletconnect/utils>query-string>decode-uri-component
    // from: arb-token-bridge-ui>@synthetixio/synpress>download>got>cacheable-request>normalize-url>query-string>decode-uri-component
    "GHSA-vcc3-ghjq-m6fr|*>@walletconnect/utils>query-string>decode-uri-component",
    "GHSA-vcc3-ghjq-m6fr|*>@synthetixio/synpress>*>query-string>decode-uri-component",
    //
    // https://github.com/advisories/GHSA-86w9-cpqp-85rv
    // node-forge RSA PKCS#1 v1.5 signature verification accepts extra nested DigestAlgorithm elements (CVE-2026-85393)
    // Reason to ignore: No patched version available (1.4.0 is the latest published version and is
    // already pinned via pnpm-workspace.yaml overrides). It is reached through listhen and through
    // Synpress's webpack-dev-server > selfsigned chain; both use node-forge to generate self-signed
    // certificates for development listeners, and application code does not verify RSA signatures with it.
    // from: app>@reown/appkit>...>@walletconnect/keyvaluestorage>unstorage>listhen>node-forge
    // from: arb-token-bridge-ui>@synthetixio/synpress>...>webpack-dev-server>selfsigned>node-forge
    "GHSA-86w9-cpqp-85rv",
    //
    // https://github.com/advisories/GHSA-vfj7-8cjw-p6xm
    // braces stack-exhaustion denial of service through deeply nested brace patterns (CVE-2026-93687)
    // Reason to ignore: No patched version available (3.0.3 is the latest published version).
    // braces only expands glob patterns we write ourselves: tailwindcss content globs, eslint and
    // fast-glob file matching at build/lint time, and the unstorage file watcher in the WalletConnect
    // chain. No untrusted input reaches it.
    // from: @headlessui/tailwindcss>tailwindcss>micromatch>braces
    // from: eslint-config-next>@next/eslint-plugin-next>fast-glob>micromatch>braces
    // from: app>@reown/appkit>...>@walletconnect/keyvaluestorage>unstorage>chokidar>braces
    "GHSA-vfj7-8cjw-p6xm",
    //
    // https://github.com/advisories/GHSA-rj75-hqrm-r3gf
    // postcss-selector-parser quadratic-time parsing of flat selectors with repeated class or id tokens allows CPU exhaustion (CVE-2026-104844)
    // Reason to ignore: Only 7.1.6 is patched and tailwindcss@3 / postcss-nested@6 pin ^6.1.x, so the fix is a major
    // bump the parents do not declare support for. The parser only runs at build time over selectors we author
    // ourselves (tailwind utilities, our own CSS); the advisory scopes the impact to services parsing untrusted
    // selectors, not build-time use.
    // from: @headlessui/tailwindcss>tailwindcss>postcss-selector-parser
    // from: tailwindcss>postcss-nested>postcss-selector-parser
    "GHSA-rj75-hqrm-r3gf",
  ],
}
